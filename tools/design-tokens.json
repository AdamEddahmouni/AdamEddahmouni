{
  "$comment": "Single source of truth for every generated asset. Consumed by tools/render-*.mjs and asserted by tools/check-contrast.mjs.",

  "grid": {
    "fullWidth": 1200,
    "cardRowMargin": 37,
    "heroCols": 4,
    "heroGutter": 22,
    "cardWidth": 640,
    "cardHeight": 300,
    "twoColWidth": 580,
    "twoColGutter": 20
  },

  "radius": { "card": 12, "chip": 6, "pill": 999, "node": 3 },

  "type": {
    "$comment": "Two embedded OFL faces + one system stack. SVG served via <img> cannot fetch webfonts, so display and mono are base64 subsetted at build time.",
    "display": { "family": "Space Grotesk", "weights": [500, 700] },
    "mono": { "family": "JetBrains Mono", "weights": [500] },
    "bodyStack": "ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "monoStack": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace",
    "scale": { "display": 44, "h1": 28, "h2": 20, "body": 15, "mono": 13, "micro": 11 }
  },

  "motion": {
    "$comment": "One focal animation per viewport. Everything else is ambient. Easing is uniform.",
    "ease": "cubic-bezier(.4,0,.2,1)",
    "ambient": "6s",
    "secondary": "3s",
    "micro": "0.4s",
    "stagger": "0.9s"
  },

  "elevation": {
    "cardShadow": "0 1px 2px rgba(11,18,32,.06), 0 8px 24px -12px rgba(11,18,32,.14)",
    "cardShadowDark": "0 1px 2px rgba(0,0,0,.4), 0 8px 24px -12px rgba(0,0,0,.6)",
    "innerHighlight": "inset 0 1px 0 rgba(255,255,255,.06)"
  },

  "schemes": {
    "dark": {
      "page": "#0d1117",
      "surface": "#161b22",
      "surfaceAlt": "#1c2430",
      "border": "#2a313c",
      "borderStrong": "#3a434f",
      "text": "#e6edf3",
      "textMuted": "#9aa7b4",
      "textFaint": "#8492a0",
      "brand": { "blue": "#2f86ff", "teal": "#19d2c7", "violet": "#7252f4" },
      "on": { "blue": "#0d1117", "teal": "#0d1117", "violet": "#ffffff" },
      "heat": ["#161b22", "#102f42", "#136e7f", "#2f86ff", "#7252f4"],
      "evidence": { "supporting": "#19d2c7", "contradictory": "#f2545b", "inconclusive": "#6e7d8c", "unasserted": "#3a434f" },
      "gridDot": "#21262d",
      "gridDotBright": "#30363d",
      "shadow": "0 1px 2px rgba(0,0,0,.4), 0 8px 24px -12px rgba(0,0,0,.6)",
      "grain": 0.028
    },
    "light": {
      "page": "#ffffff",
      "surface": "#f6f8fb",
      "surfaceAlt": "#eef2f8",
      "border": "#e3e8ef",
      "borderStrong": "#cbd5e1",
      "text": "#0b1220",
      "textMuted": "#4a5568",
      "textFaint": "#667085",
      "brand": { "blue": "#0b5fa5", "teal": "#0f766e", "violet": "#5b21b6" },
      "on": { "blue": "#ffffff", "teal": "#ffffff", "violet": "#ffffff" },
      "heat": ["#eef2f7", "#cdeef0", "#9fdedd", "#0f766e", "#5b21b6"],
      "evidence": { "supporting": "#0f766e", "contradictory": "#c02634", "inconclusive": "#667085", "unasserted": "#cbd5e1" },
      "gridDot": "#eef2f7",
      "gridDotBright": "#dbe3ee",
      "shadow": "0 1px 2px rgba(11,18,32,.06), 0 8px 24px -12px rgba(11,18,32,.14)",
      "grain": 0.02
    }
  },

  "projects": {
    "nosograph": {
      "name": "NosoGraph",
      "repo": "nosograph",
      "url": "https://github.com/AdamEddahmouni/nosograph",
      "docs": "https://adameddahmouni.github.io/nosograph/",
      "tagline": "Disease intelligence across biomedical sources",
      "desc": "Open-source research software connecting disease knowledge, evidence, and provenance.",
      "badge": { "left": "v0.2.1", "right": "Public Alpha" },
      "meta": ["Apache 2.0", "Python", "DOI 10.5281/zenodo.22055279"],
      "metrics": [["10,404", "modules"], ["25", "adapters"], ["2,445", "offline tests"]],
      "accent": "teal"
    },
    "agent-ready": {
      "name": "Agent-Ready",
      "repo": "agent-ready",
      "url": "https://github.com/AdamEddahmouni/agent-ready",
      "docs": "",
      "tagline": "A contract between repositories and coding agents",
      "desc": "Vendor-neutral specification and deterministic CLI. No API keys, no LLM calls, no network.",
      "badge": { "left": "agent-ready.yaml", "right": "5 adapters" },
      "meta": ["TypeScript", "JSON Schema", "10 CLI commands"],
      "metrics": [["10", "CLI commands"], ["5", "adapters"], ["0", "LLM calls"]],
      "accent": "blue"
    },
    "market-trading-platform": {
      "name": "Market Trading Platform",
      "repo": "market-trading-platform",
      "url": "https://github.com/AdamEddahmouni/market-trading-platform",
      "docs": "https://github.com/AdamEddahmouni/market-trading-platform/blob/main/docs/MONOREPO_WORKFLOW.md",
      "tagline": "Monorepo workspace with a verification guard",
      "desc": "Integrated trading platform with governed snapshots, a lineage ledger, and a guard on main.",
      "badge": { "left": "workspace", "right": "guarded" },
      "meta": ["Python", "TypeScript", "PowerShell", "MATLAB"],
      "metrics": [["1", "guard CLI"], ["4", "guard checks"], ["∞", "lineage ledger"]],
      "accent": "violet"
    },
    "short-squeeze-screener-internship": {
      "name": "Short Squeeze Screener",
      "repo": "short-squeeze-screener-internship",
      "url": "https://github.com/AdamEddahmouni/short-squeeze-screener-internship",
      "docs": "https://github.com/AdamEddahmouni/short-squeeze-screener-internship/blob/main/short-squeeze-core/docs/getting-started.md",
      "tagline": "Read-only short-squeeze research screener",
      "desc": "Research screener around structured market data, quality checks, and reproducibility.",
      "badge": { "left": "v0.16.0", "right": "FROZEN_DEMO" },
      "meta": ["MIT", "Python", "PowerShell"],
      "metrics": [["v0.16.0", "version"], ["0", "orders placed"], ["0", "advice given"]],
      "accent": "blue"
    }
  },

  "badges": {
    "open-source": { "label": "Open Source", "value": "builder", "accent": "teal" },
    "focus": { "label": "Focus", "value": "verifiable systems", "accent": "blue" },
    "location": { "label": "Location", "value": "Pennsylvania", "accent": "violet" },
    "status": { "label": "Status", "value": "open to collaborations", "accent": "teal" }
  },

  "icons": {
    "$comment": "Simple Icons slug -> official brand hex. CC0 1.0, so no attribution obligation.",
    "list": [
      { "slug": "python", "color": "#3776AB" },
      { "slug": "typescript", "color": "#3178C6" },
      { "slug": "javascript", "color": "#F7DF1E" },
      { "slug": "react", "color": "#61DAFB" },
      { "slug": "nextdotjs", "color": "#FFFFFF" },
      { "slug": "fastapi", "color": "#009688" },
      { "slug": "mongodb", "color": "#47A248" },
      { "slug": "supabase", "color": "#3ECF8E" },
      { "slug": "docker", "color": "#2496ED" },
      { "slug": "githubactions", "color": "#2088FF" },
      { "slug": "redis", "color": "#DC382D" },
      { "slug": "markdown", "color": "#083FA1" },
      { "slug": "git", "color": "#F05032" }
    ]
  }
}
